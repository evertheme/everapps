# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — full connection string (local Docker Compose)
POSTGRES_USER=everapps
POSTGRES_PASSWORD=everapps_secret
POSTGRES_DB=everapps
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://everapps:everapps_secret@db:5432/everapps

# Option B — individual variables (recommended on Railway; omit DATABASE_URL)
# PGHOST=${{Postgres.PGHOST}}
# PGPORT=${{Postgres.PGPORT}}
# PGUSER=${{Postgres.PGUSER}}
# PGPASSWORD=${{Postgres.POSTGRES_PASSWORD}}
# PGDATABASE=${{Postgres.POSTGRES_DB}}

# ── Encryption (Fernet key for storing PM credentials) ───────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-with-fernet

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── LLM — Server defaults ─────────────────────────────────────────────────────
# Fallback settings used when a user has not configured their own LLM provider
# in the UI. Supported values: openai | anthropic | azure_openai | ollama
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ── LLM — API keys (server-level fallback) ────────────────────────────────────
# Set the key for your default provider. Users who supply their own key in the
# UI will use theirs instead; these are only used when no per-user key exists.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OLLAMA_BASE_URL=http://localhost:11434

# ── Frontend (Railway only) ───────────────────────────────────────────────────
# Set on the frontend service; points to the backend's Railway private domain.
# BACKEND_URL=http://<backend-private-domain>:<port>
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# ── Document processing ───────────────────────────────────────────────────────
# Chunk size is resolved automatically per LLM provider (~60% of its context window).
DOC_CHUNK_OVERLAP=200
DOC_MAX_CONCURRENT_CHUNKS=3
